[Unit]
Description=Home Display agent (talks to the lights, connects out to the backend)
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/homedisplay-agent -config /etc/homedisplay/agent.json
Restart=always
RestartSec=5
# The agent needs no special privileges
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
