# Copy to .env (never commit it) and fill in.

# The domain name that points at this server. Caddy gets a certificate for it automatically.
DOMAIN=home.example.com

# bcrypt hash of the login password. Create one with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# Keep the single quotes around the value: the hash contains $ characters.
APP_PASSWORD_HASH='$2a$14$replace-with-your-hash'

# Calendar: off (default) or caldav. For iCloud use an app-specific password
# (appleid.apple.com, Sign-In and Security, App-Specific Passwords), never your Apple ID password.
APP_CALENDAR_MODE=off
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Optional: only these calendars, by name, comma separated. Empty means all of them.
CALDAV_CALENDARS=

# Only for docker-compose.local.yml (the local trial). Leave out to use sample calendar events.
# LOCAL_CALENDAR_MODE=caldav
# LOCAL_CALDAV_USERNAME=
# LOCAL_CALDAV_PASSWORD=
