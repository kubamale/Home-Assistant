# Copy to .env (never commit it) and fill in.

# The domain name that points at this server. Caddy gets a certificate for it automatically.
# (Only for docker-compose.yml, the server reachable directly from the internet. The home server on a Pi, docker-compose.pi.yml,
# does not use it: HTTPS comes from Tailscale or Cloudflare.)
DOMAIN=home.example.com

# bcrypt hash of the login password. Create one with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# Keep the single quotes around the value: the hash contains $ characters.
APP_PASSWORD_HASH='$2a$14$replace-with-your-hash'

# Only for the home server with a Cloudflare Tunnel (docker-compose.pi.yml --profile cloudflare): the token Cloudflare gives
# you when you create the tunnel. Leave empty if you use Tailscale instead.
CLOUDFLARE_TUNNEL_TOKEN=

# Encrypts the calendar passwords people save in the app (Settings -> My calendar). Any long random text, for example:
#   openssl rand -base64 32
# Without it people cannot save a calendar. Keep it: if it is lost or changed, they connect their calendars again.
APP_SECRET_KEY=

# The text assistant (Assistant tab) uses Claude. Without a key the tab says it is not set up.
# Create a key at console.anthropic.com. Also read by docker-compose.local.yml.
ANTHROPIC_API_KEY=

# Talking and listening (microphone in the Assistant tab) use Google's Gemini API.
# Create a key at aistudio.google.com and turn on billing for it: on Google's free tier it may use your requests
# (your voice) to improve its products; on a paid plan it does not.
GEMINI_API_KEY=

# Calendar: off (default) or caldav. For iCloud use an app-specific password
# (appleid.apple.com, Sign-In and Security, App-Specific Passwords), never your Apple ID password.
APP_CALENDAR_MODE=off
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Optional: only these calendars, by name, comma separated. Empty means all of them.
CALDAV_CALENDARS=

# Only for docker-compose.local.yml (the local trial). Leave out to use sample calendar events.
# LOCAL_CALENDAR_MODE=caldav
# LOCAL_CALDAV_USERNAME=
# LOCAL_CALDAV_PASSWORD=
